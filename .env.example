# Raffles Residence Hub · environment template
#
# Copy to .env and fill in what you need. Nothing here is required: every
# feature runs with all of these unset. Only this template is committed;
# every other .env* file is ignored by git.
#
# VITE_ variables are public. Vite inlines them into the browser bundle, so
# never put a credential in one.

# --- BuildingLink -----------------------------------------------------------
# Selects the adapter the front end uses. "mock" is the deterministic demo;
# "http" talks only to the Hub's own backend proxy at /api/buildinglink/*.
# See INTEGRATION.md and src/integrations/buildinglink/http/MAPPING.md.
VITE_BUILDINGLINK_MODE=mock

# BuildingLink credentials never appear in this file and are never read by
# this app. They belong to the backend proxy, which is not built yet and
# will keep its own configuration.

# --- Supabase (scaffolded, not provisioned) ---------------------------------
# Wired into the framework but unused; /health/ready reports it as skipped
# when these are empty. A service role key must never be a VITE_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Optional ----------------------------------------------------------------
# Reported by /health/ready if set; not otherwise used.
GRAPHQL_MESH_URL=
GRAPHQL_MESH_TOKEN=
